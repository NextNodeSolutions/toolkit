{
  "name": "toolkit",
  "scripts": {
    "build": "pnpm -r run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm build && pnpm -r run lint",
    "prepare": "node .husky/install.mjs",
    "type-check": "pnpm build && pnpm -r run type-check"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@nextnode-solutions/standards": "workspace:*",
    "better-sort-package-json": "1.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module"
}
